{
  "info": {
    "name": "TeamBoard Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "client_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register a new company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201',()=>pm.response.to.have.status(201));",
              "let j=pm.response.json(); pm.collectionVariables.set('client_token',j.access);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 Register with duplicate username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400',()=>pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 Login with valid credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "let j=pm.response.json(); pm.collectionVariables.set('client_token',j.access);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 Login with wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"wrong\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401',()=>pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 Query KB - no token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401',()=>pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 Query KB - valid token, keyword with results",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200)); pm.test('has results',()=>pm.expect(pm.response.json().count).to.be.above(0));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07 Query KB - valid token, no matching results",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"zzzz-no-match-zzzz\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200)); pm.test('empty',()=>{let j=pm.response.json(); pm.expect(j.count).to.eql(0); pm.expect(j.results).to.eql([]);});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "08 Query KB - missing search field",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400',()=>pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "09 Usage summary - CLIENT token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{client_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/usage-summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "usage-summary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403',()=>pm.response.to.have.status(403));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10A Admin Login (after role changed in PGAdmin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200)); let j=pm.response.json(); pm.collectionVariables.set('admin_token',j.access);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10B Usage summary - Admin token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/usage-summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "usage-summary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200)); pm.test('stats',()=>pm.expect(pm.response.json()).to.have.property('top_search_terms'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11 Verify QueryLog created - PGAdmin check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/admin/usage-summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "usage-summary",
            ""
          ]
        },
        "description": "PGAdmin manual check: SELECT * FROM api_querylog ORDER BY queried_at DESC; Confirm rows from scenarios 6 and 7 exist, including zero-result query."
      }
    }
  ]
}